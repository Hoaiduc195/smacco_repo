# App
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/accommodation_db_db?schema=public

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Groq API
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=20
GROQ_STREAMING_ENABLED=true

# External APIs
GOONG_API_KEY=your_goong_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# LLM Provider Configuration
AI_PROVIDER=groq # Set to 'cloudflare' to switch the system's LLM to Cloudflare Workers AI

# Cloudflare Workers AI Configuration
CLOUDFLARE_AI_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_AI_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts
CLOUDFLARE_AI_TIMEOUT=20

# Cloudflare R2 Storage Configuration
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=your_cloudflare_r2_bucket_name_here
CLOUDFLARE_R2_PUBLIC_URL=https://your-r2-public-url-or-subdomain.r2.dev